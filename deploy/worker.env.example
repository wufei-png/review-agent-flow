GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-with-review-bot-token
GITLAB_REVIEW_BOT_USERNAME=review-bot
REVIEW_AGENT_FLOW_PROJECT_ID=42
REVIEW_AGENT_FLOW_DB=/var/lib/review-agent-flow/shared/review-agent-flow.sqlite3
REVIEW_AGENT_FLOW_REPOSITORY=/var/lib/review-agent-flow-worker/repository
REVIEW_AGENT_FLOW_WORKTREES=/var/lib/review-agent-flow-worker/worktrees
REVIEW_AGENT_FLOW_OPERATOR_CONFIG=/etc/review-agent-flow/operator.yml
OPENAI_API_KEY=replace-with-provider-secret
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
# For a feishu_dm channel, remove FEISHU_WEBHOOK and set all three values below
# in this root-owned file. The open ID must belong to the configured app.
# FEISHU_APP_ID=replace-with-app-id
# FEISHU_APP_SECRET=replace-with-app-secret
# FEISHU_OWNER_OPEN_ID=replace-with-recipient-open-id
