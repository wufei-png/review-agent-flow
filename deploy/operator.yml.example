version: 4

backends:
  local-agent:
    enabled: true
    adapter: opencode
    command: [opencode]
    allowed_projects: ["42"]
    profiles:
      default:
        timeout_seconds: 1800
        model: openai/gpt-5.6-terra
        environment: [OPENAI_API_KEY]
        verification:
          command: [pytest, -q]

autofix_publication:
  enabled: false
  allowed_projects: ["42"]
  initial_readiness: draft
  ci_trigger: manual

notifications:
  channels:
    feishu-reviewers:
      type: feishu
      webhook_env: FEISHU_WEBHOOK
      allowed_projects: ["42"]
      user_ids: {}
    # For an owner-only direct-message deployment, replace the webhook channel
    # above with a single feishu_dm channel bound to the intended recipient:
    # feishu-owner-dm:
    #   type: feishu_dm
    #   app_id_env: FEISHU_APP_ID
    #   app_secret_env: FEISHU_APP_SECRET
    #   recipient_open_id_env: FEISHU_OWNER_OPEN_ID
    #   recipient_username: gitlab-owner-username
    #   allowed_projects: ["42"]

retention:
  sensitive_payload_days: 30
  publication_plan_backup_dir: /var/lib/review-agent-flow-worker/plan-backups
